# ============================================================
# IA Legal - configuração de exemplo
# Apenas modelos de código aberto (sem OpenAI).
# ============================================================

# Provedor de LLM (todos com modelos de código aberto):
#   ollama      -> modelo aberto rodando localmente (recomendado, offline)
#   openrouter  -> modelos abertos hospedados (OpenRouter, Groq, Together...)
#   none        -> desliga a geração de texto
# Obs.: qualquer serviço com API "compatível" funciona com LLM_PROVIDER=openrouter
# (o nome é só um rótulo; não tem relação com a empresa OpenAI).
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:1.5b
# Modelos alternativos (fallback) quando o principal falhar, separados por virgula
LLM_MODEL_FALLBACKS=
LLM_TEMPERATURE=0.2
# Limite de tokens por resposta (controla o tempo no modelo local)
LLM_MAX_TOKENS=500

# Embeddings: chroma -> modelo local do ChromaDB (código aberto, offline)
#           openai -> embeddings de serviço externo
EMBEDDING_PROVIDER=chroma
EMBEDDING_MODEL=text-embedding-3-small

# Servidor
HOST=127.0.0.1
PORT=8000

# Acesso dos alunos (opcional, recomendado ao publicar na internet)
# Se APP_PASSWORD estiver preenchido, o site pede usuário e senha (HTTP Basic).
APP_USER=professor
APP_PASSWORD=

# Importação de documentos oficiais
CHUNK_SIZE=1400
CHUNK_OVERLAP=250
MAX_CONTEXT_CHARS=24000

# Requisições às APIs públicas
HTTP_TIMEOUT=30
HTTP_DELAY=0.25
REQUEST_RETRIES=3
