# Provedor de LLM: openai | ollama | none
LLM_PROVIDER=openai

# Para OpenAI, Groq, OpenRouter, Gemini (compatível OpenAI), deixe vazio para o padrão OpenAI.
# Exemplos:
#   OpenAI:        https://api.openai.com/v1
#   Groq:          https://api.groq.com/openai/v1
#   Gemini:        https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama local:  http://localhost:11434/v1
LLM_BASE_URL=

# Chave da API. Para Ollama, qualquer valor (ou deixe vazio).
LLM_API_KEY=

# Modelo usado para responder e resumir.
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Embeddings: auto | openai | chroma
#  auto   -> usa OpenAI se houver chave, senão o modelo local do ChromaDB
#  chroma -> força modelo local (sem custo, funciona offline após o primeiro download)
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small

# Servidor
HOST=127.0.0.1
PORT=8000

# Requisições às APIs públicas
HTTP_TIMEOUT=30
HTTP_DELAY=0.25
REQUEST_RETRIES=3
